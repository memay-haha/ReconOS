# Development only. Copy to .env and fill in locally generated values.
# Never commit .env: docs/ops/configuration.md

# --- Docker Compose (infras/compose/compose.dev.yaml) ---
POSTGRES_PASSWORD=
RECONOS_DB_PASSWORD=
RECONOS_LOG_DB_PASSWORD=

# --- Core processes ---
RECONOS_DATABASE_URL=postgresql+asyncpg://reconos_app@127.0.0.1:5432/reconos
RECONOS_LOG_DATABASE_URL=postgresql+asyncpg://reconos_log_app@127.0.0.1:5432/reconos_log
RECONOS_REDIS_URL=redis://127.0.0.1:6379/0
RECONOS_REDIS_PASSWORD=
RECONOS_S3_ENDPOINT=http://127.0.0.1:9000
RECONOS_S3_BUCKET=reconos-raw-output
# Doubles as the MinIO root user and password. Password needs 8 characters or more.
RECONOS_S3_ACCESS_KEY=
RECONOS_S3_SECRET_KEY=
# <key id>:<256-bit key, base64>, newest first
RECONOS_ENCRYPTION_KEYS=
RECONOS_PUBLIC_ORIGIN=http://127.0.0.1:3000
RECONOS_LOG_LEVEL=debug

# --- Engine servers, used by `make engine-check` ---
OSMEDEUS_URL=
VIGOLIUM_URL=
