# URL of Backend API. The Next server forwards /api/* here.
RECONOS_API_URL=http://127.0.0.1:8000

# Where the E2E suite addresses the app. Playwright starts `pnpm dev` on this host and port.
RECONOS_E2E_BASE_URL=http://127.0.0.1:3000

# Account the E2E suite signs in with. Leave both empty: playwright.config.ts reads
# RECONOS_BOOTSTRAP_ADMIN_USERNAME and RECONOS_BOOTSTRAP_ADMIN_PASSWORD from the repo .env,
# the Superadmin `make init` created. Fill them in only to sign in as a different account,
# and only in a local .env, never here. Backend API must be running at RECONOS_API_URL.
RECONOS_E2E_USERNAME=
RECONOS_E2E_PASSWORD=

# `pnpm dev` answers endpoints the backend has not built with sample data from
# src/mocks/ (Mock Service Worker). A production build contains none of it.
