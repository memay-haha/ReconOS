    job ||--o{ asset_event : "sinh"
    job ||--o{ screenshot : "chụp"
    domain |o--o{ finding : "có"
    ip |o--o{ finding : "có"
    url |o--o{ finding : "có"
    service |o--o{ finding : "có"
    domain |o--o{ asset_tag : "được gắn"
    ip |o--o{ asset_tag : "được gắn"
    url |o--o{ asset_tag : "được gắn"
    service |o--o{ asset_tag : "được gắn"
