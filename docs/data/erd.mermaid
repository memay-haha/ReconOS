    url ||--o{ screenshot : "được chụp"
    raw_output ||--o| screenshot : "chứa ảnh"
    raw_output ||--o{ asset_event : "là nguồn"
    job ||--o{ finding : "phát hiện"
    raw_output ||--o{ finding : "là bằng chứng"
    finding |o--o{ finding : "trùng với"
    tag ||--o{ asset_tag : "gắn"
    tag ||--o{ finding_tag : "gắn"
    finding ||--o{ finding_tag : "có"
