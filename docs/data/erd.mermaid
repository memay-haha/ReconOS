    raw_output |o--o{ screenshot : "chứa HTML"

    user {
        uuid id PK
        text username UK
        text display_name
        text password_hash
        text role
        bool is_locked
        timestamptz last_login_at
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }
    user_session {
        uuid id PK
        uuid user_id FK
        text session_hash UK
        inet ip_address
        text user_agent
        timestamptz created_at
        timestamptz last_seen_at
        timestamptz expires_at
    }
    login_attempt {
        uuid id PK
        text username
        inet ip_address
        timestamptz attempted_at
    }
    worker {
        uuid id PK
        text name UK
        text[] tool_modules
        jsonb tool_versions
        real cpu_percent
        timestamptz last_heartbeat_at
        timestamptz created_at
    }
    worker_token {
        uuid id PK
        uuid worker_id FK
        text token_hash UK
        uuid created_by FK
        timestamptz created_at
        timestamptz last_used_at
        timestamptz revoked_at
    }
    system_setting {
        text key PK
        jsonb value
        uuid updated_by FK
        timestamptz updated_at
    }
    saved_filter {
        uuid id PK
        uuid user_id FK
        text screen
        text name
        jsonb params
        timestamptz created_at
    }
    diagnostic_run {
        uuid id PK
        text status
        int exit_code
        text output
        uuid created_by FK
        timestamptz created_at
        timestamptz finished_at
    }
    audit_log {
        uuid id PK
        uuid user_id
        uuid worker_id FK
        uuid program_id FK
        text action
        text resource_type
        uuid resource_id
        jsonb detail
        inet ip_address
        timestamptz created_at
    }
    program {
        uuid id PK
        text name UK
        text platform
        text platform_url
        text platform_handle
        text bounty_type
        text description
        text status
        uuid created_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz archived_at
    }
    program_user {
        uuid program_id PK, FK
        uuid user_id PK, FK
        uuid assigned_by FK
        timestamptz assigned_at
    }
    scope_rule {
        uuid id PK
        uuid program_id FK
        text scope_type
        text rule_type
        text value
        text reason
        uuid created_by FK
        timestamptz created_at
    }
    proxy {
        uuid id PK
        uuid program_id FK
        text name
        bytea url_encrypted
        bool is_enabled
        timestamptz created_at
        timestamptz updated_at
    }
    schedule {
        uuid id PK
        uuid program_id FK
        uuid tool_module_id FK
        text[] target
        jsonb params
        int interval_minutes
        bool is_enabled
        uuid created_by FK
        timestamptz last_run_at
        timestamptz next_run_at
        timestamptz created_at
    }
    tool_module {
        uuid id PK
        text name UK
        bool is_enabled
        jsonb default_params
        int max_concurrency
        int rate_limit_per_minute
        int timeout_minutes
        uuid updated_by FK
        timestamptz updated_at
    }
    engine {
        uuid id PK
        text name UK
        text base_url
        bytea api_key_encrypted
        bytea llm_api_key_encrypted
        bool is_enabled
        jsonb settings
        text version
        timestamptz last_tested_at
        bool last_test_ok
        timestamptz api_key_updated_at
        timestamptz ok_since
        uuid updated_by FK
        timestamptz updated_at
    }
    engine_variable {
        uuid id PK
        uuid engine_id FK
        text key
        bytea value_encrypted
        uuid updated_by FK
        timestamptz updated_at
    }
    job {
        uuid id PK
        uuid program_id FK
        uuid tool_module_id FK
        text status
        int priority
        text[] target
        jsonb params
        uuid proxy_id FK
        uuid schedule_id FK
        uuid retry_of_job_id FK
        uuid worker_id FK
        uuid created_by FK
        uuid approved_by FK
        text status_reason
        text tool_version
        timestamptz created_at
        timestamptz approved_at
        timestamptz dispatched_at
        timestamptz started_at
        timestamptz last_heartbeat_at
        timestamptz finished_at
    }
    raw_output {
        uuid id PK
        uuid job_id FK
        text filename
        text object_key UK
        text content_type
        bigint size_bytes
        text sha256
        text parse_status
        text parse_error
        timestamptz created_at
        timestamptz parsed_at
    }
    domain {
        uuid id PK
        uuid program_id FK
        text name
        text apex
        bool is_wildcard
        text cname
        text dns_status
        bool in_scope
        timestamptz first_seen_at
        timestamptz last_seen_at
        timestamptz deleted_at
    }
    ip {
        uuid id PK
        uuid program_id FK
        inet address
        int asn
        text asn_org
        text country
        bool is_private
        text cdn_name
        text ptr
        bool in_scope
        timestamptz first_seen_at
        timestamptz last_seen_at
    }
    domain_ip {
        uuid domain_id PK, FK
        uuid ip_id PK, FK
        text record_type PK
        timestamptz first_seen_at
        timestamptz last_seen_at
    }
    service {
        uuid id PK
        uuid program_id FK
        uuid ip_id FK
        int port
        text transport
        text name
        text product
        text version
        text banner
        bool in_scope
        timestamptz first_seen_at
        timestamptz last_seen_at
        timestamptz closed_at
    }
    url {
        uuid id PK
        uuid program_id FK
        uuid domain_id FK
        uuid ip_id FK
        text url
        bytea url_hash
        text scheme
        text host
        int port
        text path
        int status_code
        text title
        bigint content_length
        text content_type
        text webserver
        text favicon_hash
        timestamptz tls_not_after
        bool in_scope
        timestamptz first_seen_at
        timestamptz last_seen_at
    }
    technology {
        uuid id PK
        text name UK
        text category
    }
    url_technology {
        uuid url_id PK, FK
        uuid technology_id PK, FK
        text version
        timestamptz first_seen_at
        timestamptz last_seen_at
    }
    screenshot {
        uuid id PK
        uuid program_id FK
        uuid url_id FK
        uuid job_id FK
        uuid raw_output_id FK
        uuid html_raw_output_id FK
        text final_url
        int status_code
        text title
        text perception_hash
        jsonb http_headers
        int width
        int height
        real device_scale
        inet remote_ip
        int duration_ms
        jsonb tls
        jsonb network_log
        jsonb console_log
        jsonb cookies
        bool is_failed
        text error_message
        timestamptz captured_at
        timestamptz deleted_at
    }
    asset_event {
        uuid id PK
        uuid program_id FK
        uuid domain_id FK
        uuid ip_id FK
        uuid url_id FK
        uuid service_id FK
        text event_type
        uuid job_id FK
        uuid raw_output_id FK
        jsonb diff
        timestamptz created_at
    }
    finding {
        uuid id PK
        uuid program_id FK
        uuid job_id FK
        uuid raw_output_id FK
        uuid domain_id FK
        uuid ip_id FK
        uuid url_id FK
        uuid service_id FK
        text dedup_key
        text name
        text template_id
        text severity
        text matched_at
        text evidence
        text[] cve
        jsonb detail
        text triage_status
        uuid duplicate_of_id FK
        uuid triaged_by FK
        timestamptz triaged_at
        timestamptz first_seen_at
        timestamptz last_seen_at
    }
    tag {
        uuid id PK
        text key
        text value
        uuid created_by FK
        timestamptz created_at
    }
    asset_tag {
        uuid id PK
        uuid tag_id FK
        uuid domain_id FK
        uuid ip_id FK
        uuid url_id FK
        uuid service_id FK
        uuid created_by FK
        timestamptz created_at
    }
    finding_tag {
        uuid finding_id PK, FK
        uuid tag_id PK, FK
        uuid created_by FK
        timestamptz created_at
    }
    report {
        uuid id PK
        uuid program_id FK
        text title
        text body
        text status
        text platform_report_ref
        uuid created_by FK
        timestamptz created_at
        timestamptz updated_at
        timestamptz submitted_at
    }
    report_finding {
        uuid report_id PK, FK
        uuid finding_id PK, FK
    }
    alert {
        uuid id PK
        uuid program_id FK
        text alert_type
        text message
        uuid finding_id FK
        uuid job_id FK
        timestamptz created_at
    }
    alert_read {
        uuid alert_id PK, FK
        uuid user_id PK, FK
        timestamptz read_at
    }
